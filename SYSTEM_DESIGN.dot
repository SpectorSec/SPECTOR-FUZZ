// =============================================================================
// SPECTOR-FUZZ — Canonical System Design v5
//
// Lineage: v1 (Claude, code-grounded) -> v2 (DeepSeek, structural refactor) ->
//          v3 (Claude, reconciled against `main`) ->
//          v4 (DeepSeek, 017 Coupled Signal Buses built + integration_test feature) ->
//          v5 (Claude, 2026-07-06: Phase 0 Corpus-Priors layer + 019/020 reconciled) ->
//          v5.1 (Claude, 2026-07-07: JIT causal-path gate node [day-zero, now default] +
//               reflexive-loop RETURN edge receipt — triangulated intent/code/symptom;
//               taxonomy edges reconciled to LeakClass SSOT: leak_class.rs oracles() —
//               ERC4626 + NFT are ORPHANS (bound to no class), Invariant covers 3 oracles).
//
// Changes from v4:
//   1. Phase 0 — Corpus. exploit_analytics.duckdb (315 clean exploits) is the OFFLINE
//      mining source for the reflexive-lever catalogue. NOTE (2026-07-09): the
//      archetype_catalog.json (SHAPE prior) + divergence_diagnostic.json (ORACLE prior)
//      runtime sockets into the planner were REMOVED — pivoted away (skew-coverage-
//      program): the archetype is not a runtime provider; general dimension-skew
//      capability replaces per-corpus memorization.
//   2. 019 Causal Identity Engine: FunctionAuth MW built (Phase A) -> hardens
//      FunctionOracle (kills burn(0) phantom). ArbitraryCall MW proposed (Phase B,
//      gated on the SAME cross-contract-provenance edge as mutator.rs:757).
//   3. 020 Leak Taxonomy: the six-primitive lens is NO LONGER conceptual — it is a
//      real LeakClass SSOT enum; SnapshotDeltaOracle (idx 20, Ownership) built.
//   4. Inventory corrected: oracle suite 13-drawn -> 20 real; middlewares 5 -> ~14.
//
// SKEW-PIVOT NOTE (2026-07-09): the archetype/divergence runtime sockets were removed,
// not built. The planner is fed by live topology + the reflexive-lever catalogue (mined
// offline from the corpus); vulnerabilities are found by GENERAL dimension-skew capability
// (025 param-bound, 026 scheduler energy, 027 geometric secant, 028 cross-contract
// provenance), not by loading a per-corpus prior. Remaining red = genuine unbuilt work.
//
// LINE STYLE CONTRACT:
//   solid black  = BUILT (in code; (L) = held local/unpushed)
//   dashed red   = PROPOSED / NOT WIRED (genuine unbuilt work)
//   dashed amber = DEFERRED (decided, gated on validation — e.g. threat-model ④)
//   dotted       = feedback / confirmation / offline loop (BUILT)
//   thick        = critical path (015<->016 bridge)
// =============================================================================
digraph SPECTOR_FUZZ_CANONICAL_V4 {
    rankdir=TB;
    splines=true;
    compound=true;
    newrank=true;
    fontname="Helvetica";
    nodesep=0.45;
    ranksep=0.75;
    labelloc="t";
    fontsize=16;
    label="SPECTOR-FUZZ — Canonical System Design v5 (2026-07-06, Phase-0 Corpus Priors + 019/020)";

    node [shape=box, style=rounded, fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];

    // =========================================================================
    // LEGEND
    // =========================================================================
    subgraph cluster_legend {
        label="Legend";
        style=filled; color="#ECEFF1"; fontsize=11;
        L_built  [label="BUILT (in code)", shape=box, style=rounded];
        L_local  [label="BUILT — held LOCAL (unpushed)", shape=box, style=rounded, color="#00695C", fontcolor="#00695C"];
        L_prop   [label="PROPOSED (not wired)", shape=box, style="rounded,dashed", color="#D32F2F", fontcolor="#D32F2F"];
        L_defer  [label="DEFERRED (decided; gated on validation)", shape=box, style="rounded,dashed", color="#F57F17", fontcolor="#F57F17"];
        L_crit   [label="CRITICAL PATH", shape=box, style=rounded, penwidth=3];
        L_over   [label="Conceptual overlay (doc lens)", shape=note, style=filled, fillcolor="#F5F5F5"];
        L_built -> L_local [style=invis];
        L_local -> L_prop [style=invis];
        L_prop -> L_defer [style=invis];
        L_defer -> L_crit [style=invis];
    }

    // =========================================================================
    // DESIGN LINEAGE  (narrative intent)
    // =========================================================================
    subgraph cluster_lineage {
        label="Design Lineage (narrative intent — now realized as Phase 0)";
        style=filled; color="#F5F5F5";
        incidents [label="Historical DeFi Incidents\n(500+ reports, 2020-2026)\nreentrancy / flash-loan / oracle-manip"];
        patterns  [label="Attacker operation chains\n(calls · order · identity · tx count)\nextracted per-incident, not per-CVE"];
        incidents -> patterns [label="mined & classified"];
    }

    // =========================================================================
    // PHASE 0 — CORPUS PRIORS  (data layer — NOW CODE, was "narrative intent")
    // =========================================================================
    subgraph cluster_phase0 {
        label="Phase 0 — Corpus  (OFFLINE mining source — duckdb)";
        style=filled; color="#E1F5FE";
        corpus_db [label="exploit_analytics.duckdb  (BUILT)\n315 clean exploits · 12 PRODUCT tables\n+ attack_flows.jsonl narratives (312)\nOFFLINE mining source (no runtime edge into the engine)"];
        // archetype_catalog.json + divergence_diagnostic.json REMOVED 2026-07-09:
        // the runtime-prior sockets were pivoted away (skew-coverage-program). The corpus
        // survives only as the offline source of the reflexive-lever catalogue.
    }
    patterns -> corpus_db [label="mined · cleaned · traced · phase-framed"];

    // =========================================================================
    // PHASE 1 — STATIC BLUEPRINTING
    // =========================================================================
    subgraph cluster_phase1 {
        label="Phase 1 — Static Blueprinting  (corpus_initializer.rs / topology.rs)";
        style=filled; color="#E3F2FD";
        abi_fp    [label="ABI Fingerprinting\nselector -> ProtocolFamily\n(ERC20 / ERC4626 / Chainlink)"];
        auto_orac [label="Auto-Oracle Activation\nmaps selector -> oracle module"];
        topology  [label="Topology Intelligence\nTopologyReport\nco-occurrence + ExploitClass scores"];
        anti_topo [label="Anti-Topology Pre-flight\nmissing-guard hints\n(TopologyHints)"];
        abi_fp -> auto_orac [label="family -> oracle seed"];
        abi_fp -> topology  [label="family set -> overlap score"];
        topology -> anti_topo [label="missing guard warning"];
    }
    patterns -> abi_fp [style=dashed, label="derived from"];

    // =========================================================================
    // PHASE 2a — EXECUTION: INTERCEPTOR MIDDLEWARE LAYER  (revm hook, DURING exec)
    // =========================================================================
    subgraph cluster_interceptor {
        label="Phase 2a — Execution: Interceptor Middleware  (revm on_step, DURING exec)  [013/014/016 held LOCAL]";
        style=filled; color="#F3E5F5";

        subgraph cluster_013 {
            label="013 — Injection + Provenance  (cmp_linearity.rs)";
            style=filled; color="#FFF3E0";
            prov_src  [label="Provenance SOURCE\nCALLDATALOAD (0x35) only\nbit = 1 << arg_idx\nCALLER/ORIGIN/VALUE = clean(0)"];
            prov_tb   [label="TB.provenance: u64\nOR'd through opcodes"];
            prov_map  [label="ArgStorageProvenance\nhost.arg_slot_provenance\n(per-(addr,slot); consumer cross-contract via 028)"];
            prov_src -> prov_tb [label="bits set"];
            prov_tb -> prov_map [label="SSTORE records"];
        }

        subgraph cluster_014_mw {
            label="014 — Inline Middlewares (~14 modules, src/evm/middlewares/)";
            style=filled; color="#E8F5E9";
            mw_track [label="OracleTracker\n60-op proximity window\nCALL -> CMP -> CALL"];
            mw_flash [label="FlashloanOracle\nborrow -> oracle x2 -> move"];
            mw_stale [label="OracleStaleness\nTIMESTAMP -> CMP after CALL"];
            mw_guard [label="EmptyStateGuard\nSLOAD+JUMPI before transfer"];
            mw_dos   [label="DoSDetector\nSLOAD key before REVERT\n(reads tainted_storage)"];
            mw_perm  [label="FunctionAuth MW  (019 Phase A · BUILT)\nfunction_auth.rs · FunctionAuthTracer · type FunctionAuth\ninline frame-auth context -> o_func · kills burn(0) phantom\n(identity oracle-rooted; permission_leak_metadata field keeps domain name)", color="#1B5E20", fontcolor="#1B5E20"];
            mw_arb   [label="ArbitraryCall MW  (019 Phase B · PROPOSED — UNBLOCKED by 028)\narbitrary_call.rs (not built) · hardens o_arb (arb_call.rs)\ncross-contract arg provenance now CONSUMABLE (028 arg_reaches_storage)\n→ MW itself is the only remaining build (oracle-rooted; Message-Leak = p_msg)",
                      style="rounded,dashed", color="#D32F2F", fontcolor="#D32F2F"];
            mw_misc  [label="FeeOnTransferDetector · ValueCapture\nSha3Bypass · CallPrinter"];
        }

        subgraph cluster_016 {
            label="016 — TaintDim Engine  (cmp_linearity.rs)  [held LOCAL]";
            style=filled; color="#FFFDE7";
            dim_lat  [label="TaintDim Lattice  (max via derived Ord)\nPrice(4) > Accum(3) > Bal(2) > Ts(1) > Generic(0)\n(scalar collapse — see decoupled buses)"];
            dim_flow [label="Flow-type flags (static mut)\nPROXY_TAINT_FLOW\nPRICE_MANIPULATION_FLOW\nACCUMULATOR_INFLATION_FLOW\nPRICE_DIM_CMP_SEEN\nTIMESTAMP_DIM_LOCATED (017)\nTIMESTAMP_TAINT_WRITTEN (017)"];
            dim_tag  [label="tag_oracle_return()  (L)\nChainlink (addr-gated) -> Price\n+ REFLEXIVE selectors -> Price:\nget_virtual_price / slot0 / pricePerShare /\nconvertToAssets / exchangeRateStored / get_dy\n+ carried across CALL return-data seam (⑥)", color="#00695C", fontcolor="#00695C"];
            dim_tag -> dim_lat  [label="dim assigned at CALL return  (L)", color="#00695C", fontcolor="#00695C"];
            dim_lat -> dim_flow [label="dim reaches sink -> flag set"];
        }

        cheat [label="Cheatcode Middleware\nprank / warp / deal / store\n(NestedAction bridge)"];
    }

    auto_orac -> mw_track [label="activates"];
    auto_orac -> dim_tag  [label="registers oracle_selectors"];

    // =========================================================================
    // PHASE 2b — POST-EXECUTION: ORACLE SUITE  (~18 modules)
    // =========================================================================
    subgraph cluster_oracles {
        label="Phase 2b — Post-Execution: Oracle Suite  (20 modules, idx 0-20, src/evm/oracles/)";
        style=filled; color="#BBDEFB";
        o_erc20  [label="ERC20Oracle (0)\nfund extraction"];
        o_fresh  [label="FreshnessOracle (18)\nstale feed accepted"];
        o_4626   [label="ERC4626Oracle (17)\nshare-price manipulation"];
        o_fee    [label="FeeOnTransferOracle (13)\naccounting desync"];
        o_rebase [label="RebasingOracle (16)\nbalance desync"];
        o_func   [label="FunctionOracle (1)\nunauthorized privileged call\n[019: hardened by FunctionAuth MW]"];
        o_reent  [label="ReentrancyOracle (9)\nreentrant call detection"];
        o_inv    [label="InvariantOracle (10)\nEchidna invariants / slot trip"];
        o_arb    [label="ArbitraryCallOracle (8)\nunvalidated external target"];
        o_nft    [label="NFTOracle (12)\nERC-721/1155 ownership leak"];
        o_temp   [label="TemporalSkimOracle (19)\nmulti-block divergence > 0.001 ETH"];
        o_self   [label="SelfdestructOracle (5)"];
        o_v2     [label="V2PairOracle (2)"];
        o_own    [label="SnapshotDeltaOracle (20)  [020-B]\nEIP-1967 ownership hijack\nLeakClass::Ownership"];
        o_appr   [label="ApprovalOracle (14) · CrosschainOracle (15)\nArbTransferOracle (3) · IntegerOverflow (11)\nTypedBug (4) · Echidna (6) · StateComp (7)"];
    }

    // =========================================================================
    // CAMPAIGN PLANNER
    // =========================================================================
    subgraph cluster_campaign {
        label="Campaign Planner  (mutator.rs / campaign_planner.rs)";
        style=filled; color="#E0F7FA";
        planner  [label="plan_campaign_sampled(\n  temporal_skimming, reflexive_lever,\n  topology-rank)\n → multi-step sequences"];
        scheduler [label="Scheduler\n(VMState vote / input prioritization)\nfeedback.rs:639"];
        attacker [label="Attacker Bytecode Injection\nonERC721Received / executeOperation\ncallback surface seeds"];
        planner -> attacker [label="staged actions"];
        planner -> scheduler [label="sequence prioritized"];
    }
    topology -> planner [label="co-occurrence rank"];
    anti_topo -> mw_guard [label="hint: missing guard"];

    // ---- Phase 0 priors -> engine: REMOVED 2026-07-09 ----
    //   The archetype->planner (SHAPE prior) and divergence->auto_orac (ORACLE prior)
    //   sockets were the "load the corpus prior into the engine" edges. Pivoted away
    //   (skew-coverage-program): the archetype is NOT a runtime provider — general skew
    //   capability replaces per-corpus memorization. The corpus survives ONLY as the
    //   offline mining source for the reflexive-lever catalogue:
    corpus_db -> promote [style=dotted, color="#666666", fontcolor="#666666",
                          label="OFFLINE: data-mined REFLEXIVE_LEVER_SELECTORS\n(015 catalogue · campaign_planner.rs:239)"];

    // =========================================================================
    // 015 — PROMOTE -> LOCATE -> AMPLIFY
    // =========================================================================
    subgraph cluster_015 {
        label="015 — Promote -> Locate -> Amplify  (LedgerSecant)";
        style=filled; color="#FBE9E7";
        promote [label="PROMOTE\na-priori: TopologyReport\na-posteriori: T10 ledger delta"];
        locate  [label="LOCATE\nempirical secant sweep\n(provenance-filtered args)\n yields located_dim"];
        amplify [label="AMPLIFY\nsigned secant derivative\n→ dimension-aware probe delta\nPrice=/256, Accum=/256, Bal=/16, else=/64\nfloor: max(., BASE/1000 = 0.001 ETH)"];
        promote -> locate [label="lever candidate"];
        locate -> amplify [label="derivative sign + magnitude"];
    }

    // 013 -> LOCATE: provenance filtering
    locate_f [label="LOCATE filter\n(skip arg if bit=0)\nFAIL-OPEN: None -> don't skip", shape=diamond, style=filled, fillcolor="#FFE0B2"];
    prov_map -> locate_f [label="arg_slot_provenance"];
    locate_f -> locate [label="filtered arg set"];

    // 016 -> AMPLIFY: dimension-aware probe (CRITICAL PATH — thick)
    dim_flow -> amplify [style=bold, penwidth=3, label="CRITICAL: located_dim -> probe_delta\n(feedbacks.rs:152-156 -> read_located_dim)\nPrice=/256, Accum=/256, Bal=/16, else=/64"];

    // AMPLIFY -> planner: mutator bias feedback
    amplify -> planner [label="signed derivative + dim probe → next mutation biased"];

    // =========================================================================
    // GHOST IDENTITIES (004) + TEMPORAL SKIMMING (005)
    // =========================================================================
    ghost    [label="Ghost Identities (004)\nTrustedCallerMetadata\npopulated by FunctionOracle", shape=note, style=filled, fillcolor="#D1C4E9"];
    temporal [label="Temporal Skimming (005)\nwarp insertion + temporal skim oracle\ndivergence > 0.001 ETH\nWarp(10) between campaign steps", shape=note, style=filled, fillcolor="#B2DFDB"];

    // =========================================================================
    // DECOUPLED BUSES  — 3 remaining dashed-red, 1 now BUILT (017)
    // =========================================================================
    dim_flow -> temporal [style=bold, color="#1B5E20", fontcolor="#1B5E20",
                          label="017 Wire B: TIMESTAMP_DIM_LOCATED + --dimension-warp\nflag published in feedbacks, planner warp gate\n(campaign_planner.rs:307-310)\nts_seen survival: 017 Wire A (cmp_linearity.rs:291 / :314)"];
    ghost    -> prov_src [style=dashed, color="#F57F17", fontcolor="#F57F17",
                          label="DEFERRED (2026-07-09, threat-model ④): caller identity -> provenance\nCALLER = clean(0); calldata-only threat model KEPT.\nRevisit after live validation shows missed confused-deputy cases."];
    prov_map -> locate   [color="#00695C", fontcolor="#00695C",
                          label="028 BUILT: cross-contract provenance CONSUMPTION\narg_reaches_storage ORs per_slot across ALL contracts\n(was same-contract only) — callee/proxy-target levers now kept"];
    dim_flow -> scheduler [color="#00695C", fontcolor="#00695C",
                          label="026-B BUILT: dim_flow -> scheduler ENERGY\nper-testcase located_dim stamped in on_add + dim_boost\n(PRICE 1.75x / ACCUM 1.4x, decaying via dim_hits)"];

    // =========================================================================
    // LIQUIDATION — EXTRACTABILITY CONFIRMATION
    // =========================================================================
    liquid [label="LiquidationRouter::route_to_base()\n(liquidation_router.rs:11)\nDEX-native swap confirmation\nnet-realized ledger delta", shape=box3d, style=filled, fillcolor="#C8E6C9"];
    o_erc20 -> liquid [label="detected tokens -> route discovery"];
    o_nft   -> liquid [label="detected NFT -> liquidation"];

    // ① SUPERSEDED 2026-07-09 (was "profit-confirmed -> boost AMPLIFY confidence", red PROPOSED):
    // the riff concluded oracle materiality is NOT a verdict->amplify confidence boost — it's a
    // missing OBJECTIVE. Built as Feature 029 (divergence optimization), drawn below. Kept as a
    // dotted marker of the resolution, not a proposed edge.
    liquid -> amplify [style=dotted, color="#00695C", fontcolor="#00695C",
                       label="SUPERSEDED by 029: materiality → divergence OBJECTIVE\n(not a verdict→amplify confidence boost)"];

    // =========================================================================
    // 029 — DIVERGENCE OPTIMIZATION  (Phase-1 optimization mode — BUILT 2026-07-09, 9643867)
    //   The missing Phase 1: maximize oracle DIVERGENCE MAGNITUDE (the invariant break) so
    //   small-tolerance / rounding-drift bugs become reachable BEFORE extraction. Objective =
    //   read_divergence(), NOT CMP_MAP (value secant) or profit (ledger secant). Alex/Recon's
    //   "optimization mode": maximize the break, THEN extract.
    // =========================================================================
    subgraph cluster_029 {
        label="029 — Divergence Optimization  (Phase 1: maximize the break, THEN extract)";
        style=filled; color="#E0F2F1";
        div_pub  [label="publish_divergence / read_divergence\n(feedbacks.rs — thread-local, mirrors LEDGER_OBJECTIVE)", color="#00695C", fontcolor="#00695C"];
        div_sec  [label="apply_divergence_secant  (MAGNITUDE axis)\nmutator.rs — peak-find via secant_step_signed\nsets pin_gate on the +→− peak", color="#00695C", fontcolor="#00695C"];
        div_fb   [label="DivergenceFeedback  (SEQUENCE axis)\nfeedbacks.rs — climbs the ceiling, votes;\nhonors pin_gate (stops voting on peak)", color="#00695C", fontcolor="#00695C"];
        div_pub -> div_sec [label="objective"];
        div_pub -> div_fb  [label="objective"];
    }
    o_4626 -> div_pub [color="#00695C", fontcolor="#00695C",
                       label="029 beachhead: publish max(price_delta, share_delta)\nBEFORE the boolean gate (erc4626.rs:147)"];
    div_sec -> amplify [style=bold, penwidth=2, color="#00695C", fontcolor="#00695C",
                        label="P1→P3 HANDOFF: pin_gate ⇒ divergence inert +\nDivergenceFeedback stops voting ⇒ extraction (ledger secant + TokenBalance) takes over"];

    // =========================================================================
    // SIX PRIMITIVE-LEAK TAXONOMY  (LeakClass SSOT — leak_class.rs; edges = oracles())
    //   v5.1 reconcile: Value=[FeeOnTransfer,ERC20,Rebasing]  Invariant=[Invariant,StateComp,Echidna]
    //   Ownership=[Ownership]  Control=[Reentrancy]  Message=[ArbitraryCall]  Permission=[Function].
    //   ERC4626 + NFT bind to NO class (red orphans). middleware() is Option<MiddlewareType> = 1 MW/primitive.
    // =========================================================================
    // 019 inline middlewares harden the post-hoc oracles with during-exec info
    mw_perm -> o_func [color="#1B5E20", fontcolor="#1B5E20", label="019A BUILT: inline frame-auth\n→ materiality guard (no burn(0))"];
    mw_arb  -> o_arb  [style="dashed", color="#D32F2F", fontcolor="#D32F2F", label="019B PROPOSED — UNBLOCKED by 028:\ncross-contract provenance now consumable\n(arg_reaches_storage); arbitrary_call.rs MW itself unbuilt"];

    subgraph cluster_prim {
        label="Six Primitive-Leak Taxonomy  (020: LeakClass SSOT enum — a real binding, not conceptual)";
        style=filled; color="#FFF3E0"; fontcolor="#666666";
        p_ctrl [label="1  Control Leak", shape=note, style=filled, fillcolor="#FFFDE7"];
        p_val  [label="2  Value Leak", shape=note, style=filled, fillcolor="#FFFDE7"];
        p_msg  [label="3  Message Leak", shape=note, style=filled, fillcolor="#FFFDE7"];
        p_perm [label="4  Permission Leak", shape=note, style=filled, fillcolor="#FFFDE7"];
        p_inv  [label="5  Invariant Leak", shape=note, style=filled, fillcolor="#FFFDE7"];
        p_own  [label="6  Ownership Leak", shape=note, style=filled, fillcolor="#FFFDE7"];
    }
    o_reent -> p_ctrl [style=dashed, color="#666666", label="reentrant entry"];
    o_erc20 -> p_val  [style=dashed, color="#666666", label="balance delta"];
    o_4626  -> p_val  [style=dashed, color="#666666", label="ERC4626 share-price manip\n(BOUND: OracleType::ERC4626 → LeakClass::Value SSOT)"];
    o_fee   -> p_val  [style=dashed, color="#666666", label="fee desync"];
    o_rebase -> p_val [style=dashed, color="#666666", label="rebasing desync"];
    o_arb   -> p_msg  [style=dashed, color="#666666", label="unvalidated target"];
    o_func  -> p_perm [style=dashed, color="#666666", label="unauth privileged call"];
    o_inv   -> p_inv  [style=dashed, color="#666666", label="invariant violation"];
    o_appr  -> p_inv  [style=dashed, color="#666666", label="SSOT: Invariant ALSO covers\nStateComparison(7) + Echidna(6)\n(both live in this node)"];
    o_nft   -> p_own  [style=dashed, color="#666666", label="NFT ownership\n(BOUND: OracleType::NFT → LeakClass::Ownership SSOT)"];
    o_own   -> p_own  [color="#666666", label="020-B: EIP-1967 slot delta (BUILT home)"];
    liquid  -> p_val  [style=dotted, color="#666666", label="confirms extractability"];
    liquid  -> p_own  [style=dotted, color="#666666", label="confirms extractability"];

    // =========================================================================
    // CROSS-CLUSTER INVISIBLE RANK EDGES (layout only)
    // =========================================================================
    attacker -> cheat [style=invis];
    cheat    -> mw_flash [style=invis];
    mw_flash -> o_self [style=invis];

    // =========================================================================
    // v5.1 ADDENDUM (2026-07-07) — DAY-ZERO JIT GATE + REFLEXIVE-LOOP RETURN EDGE
    //   Two triangulated receipts (intent ∧ code ∧ symptom). NOTE: cross-contract
    //   provenance (prov_map->locate), ghost identity (ghost->prov_src), and
    //   dim->scheduler energy (dim_flow->scheduler) were ALREADY drawn above — the
    //   doc already held that intent. Only these two were genuinely missing.
    // =========================================================================

    // (A) JIT Causal-Path Gate — the suppressor the diagram never depicted.
    //     #[cfg(concolic_secant_dispatch)] was EXCLUDED from default features in EVERY
    //     prior build (absent/uncompiled, NOT dead code). Added to default 2026-07-07 = DAY ZERO.
    jit_gate [label="JIT Causal-Path Gate  (feedback.rs:300)  [BUILT 2026-07-07 → default · DAY ZERO]\n#[cfg(concolic_secant_dispatch)] · re-executes bug input w/ CmpLinearityTaint\nregister ONLY if attacker provenance reaches the sink; else SUPPRESS\n(kills burn(0) = sink-without-source). Absent from ALL prior campaigns.",
              shape=diamond, style=filled, fillcolor="#B2DFDB", color="#00695C", fontcolor="#00695C", penwidth=2];
    o_func  -> jit_gate [color="#00695C", fontcolor="#00695C", label="bug_idx fires\n(feedback.rs:292 loops ALL oracles through the gate)"];
    prov_tb -> jit_gate [style=dotted, color="#00695C", fontcolor="#00695C", label="re-run taint reads provenance"];
    jit_gate -> promote [style=dotted, color="#00695C", fontcolor="#00695C", label="PASS (provenance-backed)\n→ register + a-posteriori ledger promote"];

    // (B) Reflexive-loop RETURN edge — the arrow that wasn't on the PNG. Code-traced 2026-07-07:
    //     the loop CLOSES, but through the MUTATOR, not the scheduler.
    //       produce: feedbacks.rs:459 global high-water PromotionCandidate (best_inflow)
    //       consume: mutator.rs:667 reads it EVERY iter, pins matching campaign step
    //       gap:     PowerABIScheduler (evm/scheduler.rs:305) never boosts energy for
    //                inputs containing the promoted (contract,selector)
    promote -> scheduler [color="#00695C", fontcolor="#00695C", penwidth=2,
                          label="026-A BUILT: reflexive-loop RETURN arrow (was the triangulated dropped edge)\npromote_boost in CorpusPowerABITestcaseScore::compute — candidate (contract,selector)\nmatch -> 2.0x decaying energy (promote_hits). Loop now closes via SCHEDULER energy,\nnot just the mutator (mutator.rs:667)."];
}
